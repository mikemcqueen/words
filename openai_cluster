upstream gpu_cluster {
     zone gpu_cluster_zone 64k;  # Shared memory for connection counting across workers
     least_conn;

     #server 127.0.0.1:8000 max_conns=2;
     #server 192.168.0.112:8000 max_conns=2; # MINERVA
     
     server 192.168.0.111:8000 max_conns=1; # JUNIPER
     server 192.168.0.198:8000 max_conns=1; # MINI
     #queue 2 timeout=5s;  # queue up to N requests, wait 5s for a slot

     #keepalive 6;  # Maintain persistent connections to backends

     #server 192.168.0.110:8000 max_conns=2; # RAINBOW
}


server {
    listen 80;

    # Add the custom access log here
    access_log /var/log/nginx/access.log debug_routing;

    location / {
        proxy_pass http://gpu_cluster;
        proxy_http_version 1.1;
        #proxy_set_header Connection ""; # when keepalive
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    location /v1/chat/completions {
         proxy_pass http://gpu_cluster/v1/chat/completions;
         proxy_http_version 1.1;
         proxy_set_header Connection "close";
         #proxy_set_header Connection ""; # when keepalive
         proxy_set_header Host $host;
         proxy_set_header X-Real-IP $remote_addr;
         proxy_read_timeout 300s;
    }
}
